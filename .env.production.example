# Secrets for docker-compose.prod.yml. Copy to .env on the server and fill in.
# Everything non-secret (URL, CORS, database path) is set in the compose file.
#
# Generate each secret with:  openssl rand -base64 32
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Gmail account that sends the contact-form emails (use an app password).
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional contact-form limits (defaults shown).
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=900000
# CONTACT_DAILY_CAP=100
